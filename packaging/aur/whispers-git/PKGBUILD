pkgname=whispers-git
_pkgname=whispers
pkgver=r0.0000000
pkgrel=1
pkgdesc='Local intended-text dictation for Wayland (latest git build)'
arch=('x86_64')
url='https://github.com/OneNoted/whispers'
license=('MIT')
makedepends=('cargo' 'git')
depends=('bzip2' 'curl' 'gcc-libs' 'glibc' 'pipewire-audio' 'wl-clipboard' 'wtype')
optdepends=(
  'libnotify: desktop status notifications'
  'whisper.cpp: fallback transcription when the streaming runtime is unavailable'
)
provides=('whispers')
conflicts=('whispers')
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgname"
  if git describe --long --abbrev=7 --tags >/dev/null 2>&1; then
    git describe --long --abbrev=7 --tags | sed 's/^v//; s/-/.r/; s/-/./g'
  else
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$srcdir/$_pkgname"
  cargo fetch --locked
}

build() {
  cd "$srcdir/$_pkgname"
  cargo build --frozen --release
}

package() {
  cd "$srcdir/$_pkgname"
  install -Dm755 target/release/whispers "$pkgdir/usr/bin/whispers"
  install -Dm644 packaging/systemd/whispers.service \
    "$pkgdir/usr/lib/systemd/user/whispers.service"
  install -Dm644 sounds/start.wav "$pkgdir/usr/share/whispers/sounds/start.wav"
  install -Dm644 sounds/stop.wav "$pkgdir/usr/share/whispers/sounds/stop.wav"
  install -Dm644 README.md "$pkgdir/usr/share/doc/whispers/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/whispers/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/whispers/NOTICE"
}
